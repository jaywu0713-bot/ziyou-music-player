{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "自用音乐播放器",
  "version": "0.17.0",
  "identifier": "com.jaywu.ziyoumusic",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run desktop:build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "自用音乐播放器",
        "url": "desktop.html",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "visualization",
        "title": "自用 · 音频可视化",
        "url": "visualization.html",
        "width": 620,
        "height": 360,
        "minWidth": 360,
        "minHeight": 220,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "lyrics",
        "title": "自用 · 歌词",
        "url": "lyrics.html?part=current",
        "width": 780,
        "height": 88,
        "x": 240,
        "y": 80,
        "visible": false,
        "focus": false,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false
      },
      {
        "label": "lyrics-next",
        "title": "自用 · 下一句歌词",
        "url": "lyrics.html?part=next",
        "width": 780,
        "height": 76,
        "x": 240,
        "y": 180,
        "visible": false,
        "focus": false,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "fullscreen": false
      },
      {
        "label": "mini",
        "title": "自用 · 迷你播放器",
        "url": "mini.html",
        "width": 480,
        "height": 250,
        "minWidth": 360,
        "minHeight": 220,
        "visible": false,
        "resizable": true,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "resources": [
      "resources/fpcalc",
      "resources/THIRD_PARTY_NOTICES.md",
      "resources/vocal-engine/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
